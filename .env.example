# Copy to .env.local and fill in. Never commit real values.
# Only values prefixed VITE_ are sent to the browser, so only put public values there.

# Supabase (Phase 1). The anon key is public by design; Row Level Security protects the data.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Map tiles (Phase 3). OpenFreeMap needs no key; keep the style URL here so it is easy to swap.
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# Optional: dev-server tunnel host (read by vite.config.ts, not sent to the browser)
# DEV_ALLOWED_HOST=my-tunnel.ngrok-free.dev

# NEVER put these in a VITE_ variable or in the repo. They belong in server functions / host secrets:
# SUPABASE_SERVICE_ROLE_KEY
# PAYSTACK_SECRET_KEY
# SMS_PROVIDER_API_KEY
